{
  "name": "til-blog",
  "description": "noriyo_tcp's TIL (Today I Learned) blog built with Astro.",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "format:astro": "prettier --write \"src/**/*.astro\"",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "emoji-regex": "^11.0.0",
    "gemoji": "^8.1.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hastscript": "^9.0.1",
    "markdown-it": "^15.0.3",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-calendar": "^5.0.9",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "pagefind": "^1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sass-embedded": "^1.106.1",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  }
}
